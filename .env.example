# ==============================================================
# iCalculei - variáveis de ambiente
# Copie este arquivo para ".env" e preencha. O ".env" nunca vai para o Git.
# Onde colocar (vale o primeiro que existir): um nível acima do projeto, dois níveis acima
# ou na raiz do projeto. Em produção, deixe fora da pasta do site (fora do alcance do navegador).
# ==============================================================

# --------------------------------------------------------------
# Site
# --------------------------------------------------------------
APP_NAME=iCalculei
# local = desenvolvimento | production = servidor
APP_ENV=local
# true mostra os erros na tela (NUNCA em produção)
APP_DEBUG=true
# Endereço do site, sem barra no final (ex.: https://icalculei.com.br)
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo
# Chave secreta. Gere com: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# --------------------------------------------------------------
# Banco de dados (MySQL)
# No cPanel, o nome do banco e o usuário recebem o prefixo da conta
# --------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# --------------------------------------------------------------
# Sessão (usada no contato e no painel)
# --------------------------------------------------------------
SESSION_NAME=icalculei_session

# --------------------------------------------------------------
# Painel administrativo (/painel): um único usuário e senha.
# Senha com no mínimo 10 caracteres. Enquanto estiverem vazios, o painel fica desativado.
# Trocar qualquer um dos dois desconecta quem estiver logado.
# --------------------------------------------------------------
ADMIN_USER=
ADMIN_PASSWORD=
# "Manter conectado" no login do painel (180 dias). Qualquer texto longo e aleatório.
# Para desconectar TODOS os aparelhos, troque esta chave. Vazia = a opção não aparece no login.
# Gerar uma chave nova: php -r "echo bin2hex(random_bytes(32));"
ADMIN_REMEMBER_KEY=


# --------------------------------------------------------------
# Anúncios (Google AdSense)
# --------------------------------------------------------------
# ID do AdSense (ca-pub-...), preencher depois da aprovação
ADSENSE_CLIENT=
# true = mostra caixas cinzas onde os anúncios vão ficar (só em desenvolvimento)
ADS_PLACEHOLDERS=true

# --------------------------------------------------------------
# Responsável pelo site
# Aparece nos Termos de uso, na Política de privacidade e no Contato.
# CONTACT_EMAIL também recebe o aviso de novas mensagens (em produção).
# --------------------------------------------------------------
CONTACT_EMAIL=
SITE_OWNER_NAME=
SITE_OWNER_DOCUMENT=
SITE_OWNER_CITY=

# --------------------------------------------------------------
# Atualizar site pelo painel (/painel/atualizar): baixa o código do GitHub e roda as migrations.
# DEPLOY_TOKEN: só se o repositório for privado. Crie um token "fine-grained" no GitHub
# (Settings → Developer settings) com acesso só a este repositório e permissão Contents: Read-only.
# No computador de desenvolvimento (APP_ENV=local) o botão fica bloqueado.
# --------------------------------------------------------------
DEPLOY_REPO=michellmics/icalculei
DEPLOY_BRANCH=main
DEPLOY_TOKEN=

# --------------------------------------------------------------
# Calculadora de viagem (/calculadoras/custo-de-viagem): rota no mapa e pedágios no caminho.
# ORS_API_KEY: chave GRÁTIS do OpenRouteService (openrouteservice.org → Sign up → Dashboard → token).
# Cota grátis: 2.000 rotas e 1.000 buscas de endereço por dia. Vazia = a calculadora avisa que não está configurada.
# HTTP_CA_BUNDLE: só no computador de desenvolvimento, se o PHP não validar HTTPS.
# Use "windows" (certificados do Windows) ou o caminho de um arquivo .pem/.crt.
# Em produção deixe vazio.
# --------------------------------------------------------------
ORS_API_KEY=

# Histórico da FIPE pelo Cloudflare Worker (opcional). A FIPE só responde a acessos do Brasil e a hospedagem
# fica nos EUA: o NAVEGADOR do visitante chama o Worker de cloudflare/fipe-worker.js (passo a passo no arquivo).
FIPE_PROXY_URL=
HTTP_CA_BUNDLE=
