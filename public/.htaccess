# -MultiViews: sem isso, o Apache entrega o arquivo "parecido" (ex.: /painel → painel.webmanifest) em vez de chamar o index.php
Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Em produção, descomente as duas linhas abaixo para forçar HTTPS
    # RewriteCond %{HTTPS} off
    # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Tudo que não for arquivo existente (CSS, JS, imagem) vai para o index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# Bloqueia arquivos ocultos (que começam com ponto)
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# Cache dos arquivos estáticos (o endereço muda a cada versão: ?v=...)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# PWA: tipo certo para os manifestos e service workers sempre atualizados
AddType application/manifest+json .webmanifest
<IfModule mod_headers.c>
    <FilesMatch "^(sw|sw-painel)\.js$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# Velocidade (Core Web Vitals): compressão gzip dos textos e cache longo dos arquivos estáticos
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/xml application/manifest+json image/svg+xml
</IfModule>
<IfModule mod_expires.c>
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
AddType image/webp .webp

# Cache de 1 ano para arquivos estáticos: o endereço muda a cada versão (?v=data), então nunca fica desatualizado.
# (Os service workers logo abaixo ficam sem cache, para as atualizações chegarem na hora.)
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|webp|jpe?g|png|svg|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "^(sw|sw-painel)\.js$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
</IfModule>
AddType font/woff2 .woff2
